# -----------------------------
# APLICAÇÃO (não secretos)
# -----------------------------
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------
# POSTGRESQL
# -----------------------------
# Estes nomes podem ficar no .env.example.
POSTGRES_USER=postgres
POSTGRES_DB=integrador

# SEGREDO: gere um valor local e coloque somente no seu .env.
POSTGRES_PASSWORD=CHANGE-ME-GENERATE-A-LOCAL-PASSWORD

# -----------------------------
# SUPERTOKENS
# -----------------------------
# A imagem é pública e pode ser versionada.
SUPERTOKENS_IMAGE=supertokens/supertokens-postgresql:12.1.1

# SEGREDO: gere com "openssl rand -hex 32".
SUPERTOKENS_API_KEY=CHANGE-ME-GENERATE-WITH-OPENSSL-1234567890

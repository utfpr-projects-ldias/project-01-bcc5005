PORT=3001
# API_PUBLIC_URL=http://localhost:3001 (origem pública, sem /auth)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

POSTGRES_USER=postgres
POSTGRES_DB=integrador
POSTGRES_PASSWORD=CHANGE_ME

SUPERTOKENS_IMAGE=supertokens/supertokens-postgresql:12.1.1
SUPERTOKENS_API_KEY=CHANGE_ME

# TEC08-01: limites tecnicos PROVISORIOS ate PQ-11 (bytes)
ARQUIVOS_MAX_ARQUIVO_BYTES=16777216
ARQUIVOS_MAX_TOTAL_BYTES=1073741824

# Opcional: se usuário/senha/banco contêm caracteres reservados de URI, informe
# uma URL com cada componente codificado (ex.: senha a@b -> a%40b).
# POSTGRES_CONNECTION_URI=postgresql://postgres:senha%40exemplo@database:5432/integrador
# Valores brutos POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB continuam obrigatórios.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=60000
DB_MIGRATION_LOCK_TIMEOUT_MS=30000
DB_MIGRATION_STATEMENT_TIMEOUT_MS=0
